  Windows application manifest.

  requireAdministrator is not cosmetic: creating a TUN interface (wintun) needs
  administrator rights, and so does writing machine-level routing state. Without
  it the app starts fine and then fails deep inside the core with a log the user
  cannot act on. Elevating at launch turns that into a single UAC prompt at the
  moment the user asked for the app.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="cn.luoqingciya.triproxy" type="win32" />

  <!--
    Common Controls v6.

    This block is not optional and not decorative. Without it the loader binds
    comctl32 v5, which does not export TaskDialogIndirect, and the app dies
    before main() with "unable to locate the entry point". Replacing Tauri's
    default manifest to add requireAdministrator silently dropped this, which is
    exactly how the first packaged build shipped broken.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Crisp text on high-DPI displays instead of a blurry scaled window. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
